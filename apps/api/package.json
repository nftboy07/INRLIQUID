{
  "name": "@inrliquid/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/migrate.js && node dist/server.js",
    "reconcile": "node dist/reconcile.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @inrliquid/domain build && pnpm --filter @inrliquid/adapters build && node --experimental-strip-types --test",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inrliquid/adapters": "workspace:*",
    "@inrliquid/domain": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.3",
    "fastify-raw-body": "^5.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
