NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Development only. Must correspond to a valid UUID accepted by the API dev-header mode.
# Leave empty in production. ALLOW_DEV_USER_HEADER must stay false in production.
NEXT_PUBLIC_DEV_USER_ID=
# Publishable key only. Never put STRIPE_SECRET_KEY in the web app.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
