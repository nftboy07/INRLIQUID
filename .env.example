NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=
REDIS_URL=
# Development only. Replace with real authenticated session/JWT context before live money movement.
ALLOW_DEV_USER_HEADER=true
BROKER_PROVIDER=unconfigured
BROKER_API_BASE_URL=
BROKER_API_KEY=
MARKET_DATA_PROVIDER=unconfigured
MARKET_DATA_API_BASE_URL=
MARKET_DATA_API_KEY=
UPI_PROVIDER=razorpay
UPI_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_PAYOUT_ACCOUNT_NUMBER=
STRIPE_API_BASE_URL=https://api.stripe.com/v1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CARD_ENABLED=true
# Stripe UPI availability depends on the Stripe account/country configuration. Keep false until Stripe enables it.
STRIPE_UPI_ENABLED=false
# Stripe stablecoin/crypto payments are account-eligibility dependent. Keep false until explicitly enabled by Stripe.
STRIPE_CRYPTO_ENABLED=false
# Server-side settlement quote used only for the optional crypto-to-INR wallet credit path.
# Replace with a trusted real-time FX/risk service before production; do not use a stale static rate for live money.
CRYPTO_USD_INR_RATE=
